  "rules": [
    {
      "id": "whose turn",
      "when": {
        "start": true
      },
      "do": [
        {
          "set": [
            "player",
            "next_player"
          ]
        }
      ]
    },
    {
      "id": "restore turn",
      "when": {
        "event": "loaded"
      },
      "do": [
        {
          "set": [
            "player",
            "next_player"
          ]
        }
      ]
    },
    {
      "id": "clock",
      "when": {
        "every": 1
      },
      "do": [
        {
          "add": [
            "timeleft",
            -1
          ]
        }
      ]
    },
    {
      "id": "hurt",
      "when": {
        "touch": [
          "player",
          "hazard"
        ]
      },
      "do": [
        {
          "add": [
            "lives",
            -1
          ]
        },
        {
          "set": [
            "combo",
            0
          ]
        },
        {
          "set": [
            "invuln",
            "time + 1.1"
          ]
        },
        {
          "destroy": "other"
        },
        {
          "play": "hit"
        },
        {
          "shake": 4
        },
        {
          "burst": {
            "at": "self",
            "n": 14,
            "color": "#ff86a0",
            "speed": [
              35,
              95
            ],
            "life": [
              0.2,
              0.55
            ],
            "size": 2
          }
        }
      ],
      "if": "time > invuln"
    },
    {
      "id": "no hearts",
      "when": {
        "every": 0.05
      },
      "do": [
        {
          "end": "lose"
        }
      ],
      "if": "lives <= 0"
    },
    {
      "id": "bank speed bonus",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "banked",
            "score + (ended == 1)*(timeleft + lives*5)"
          ]
        }
      ]
    },
    {
      "id": "save record",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "last_score",
            "banked"
          ]
        },
        {
          "add": [
            "rounds",
            1
          ]
        },
        {
          "add": [
            "total",
            "banked"
          ]
        },
        {
          "set": [
            "next_player",
            "3-player"
          ]
        }
      ]
    },
    {
      "id": "best overall",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "best",
            "banked"
          ]
        }
      ],
      "if": "banked > best"
    },
    {
      "id": "best player one",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "best1",
            "banked"
          ]
        }
      ],
      "if": "player == 1 && banked > best1"
    },
    {
      "id": "best player two",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "best2",
            "banked"
          ]
        }
      ],
      "if": "player == 2 && banked > best2"
    },
    {
      "id": "rank up",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "rank",
            "1 + (total >= 150) + (total >= 400) + (total >= 800) + (total >= 1500)"
          ]
        }
      ]
    },
    {
      "id": "celebrate",
      "when": {
        "end": "win"
      },
      "do": [
        {
          "add": [
            "wins",
            1
          ]
        },
        {
          "play": "win"
        },
        {
          "burst": {
            "at": [
              240,
              120
            ],
            "n": 45,
            "color": "#ffde90",
            "speed": [
              35,
              95
            ],
            "life": [
              0.2,
              0.55
            ],
            "size": 2
          }
        }
      ]
    },
    {
      "id": "next turn",
      "when": {
        "press": "action"
      },
      "do": [
        {
          "restart": true
        }
      ],
      "if": "ended"
    },
    {
      "id": "controller music",
      "when": {
        "press": "pause"
      },
      "do": [
        {
          "music": "toggle"
        }
      ]
    },
    {
      "id": "slam",
      "when": {
        "press": "action"
      },
      "do": [
        {
          "set": [
            "slam",
            1
          ]
        },
        {
          "velocity": {
            "target": "id:p",
