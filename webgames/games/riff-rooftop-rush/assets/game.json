  "rules": [
    {
      "id": "whose turn",
      "when": {
        "start": true
      },
      "do": [
        {
          "set": [
            "player",
            "next_player"
          ]
        }
      ]
    },
    {
      "id": "restore turn",
      "when": {
        "event": "loaded"
      },
      "do": [
        {
          "set": [
            "player",
            "next_player"
          ]
        }
      ]
    },
    {
      "id": "clock",
      "when": {
        "every": 1
      },
      "do": [
        {
          "add": [
            "timeleft",
            -1
          ]
        }
      ]
    },
    {
      "id": "hurt",
      "when": {
        "touch": [
          "player",
          "hazard"
        ]
      },
      "do": [
        {
          "add": [
            "lives",
            -1
          ]
        },
        {
          "set": [
            "combo",
            0
          ]
        },
        {
          "set": [
            "invuln",
            "time + 1.1"
          ]
        },
        {
          "destroy": "other"
        },
        {
          "play": "hit"
        },
        {
          "shake": 4
        },
        {
          "burst": {
            "at": "self",
            "n": 14,
            "color": "#ff86a0",
            "speed": [
              35,
              95
            ],
            "life": [
              0.2,
              0.55
            ],
            "size": 2
          }
        }
      ],
      "if": "time > invuln && air == 0"
    },
    {
      "id": "no hearts",
      "when": {
        "every": 0.05
      },
      "do": [
        {
          "end": "lose"
        }
      ],
      "if": "lives <= 0"
    },
    {
      "id": "bank speed bonus",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "banked",
            "score + (ended == 1)*(timeleft + lives*5)"
          ]
        }
      ]
    },
    {
      "id": "save record",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "last_score",
            "banked"
          ]
        },
        {
          "add": [
            "rounds",
            1
          ]
        },
        {
          "add": [
            "total",
            "banked"
          ]
        },
        {
          "set": [
            "next_player",
            "3-player"
          ]
        }
      ]
    },
    {
      "id": "best overall",
      "when": {
        "end": "any"
      },
      "do": [
        {
          "set": [
            "best",
            "banked"
          ]
