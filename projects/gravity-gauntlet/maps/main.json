        "name": "full speedrun collects all cores triggers domino cascade and wins",
        "spawn_group": "solo",
        "players": [{ "id": "p1", "character": "human", "spawn": "start" }],
        "script": [
          { "player": "p1", "walk": "-9,-3" },
          { "player": "p1", "wait": 0.5 },
          { "player": "p1", "walk": "-4,0; 0,-5" },
          { "player": "p1", "wait": 0.3 },
          { "player": "p1", "walk": "8.5,-5" },
          { "player": "p1", "wait": 0.3 },
          { "player": "p1", "walk": "4,4" },
          { "player": "p1", "wait": 0.3 },
          { "player": "p1", "walk": "12,0; 18,3" },
          { "player": "p1", "wait": 0.3 },
          { "player": "p1", "walk": "22.5,0" }
        ],
        "max_seconds": 35,
        "expect": [
          { "var": "cores", "eq": 4 },
          { "var": "domino_tripped", "eq": 1 },
          { "event": "domino_fired", "count": 1 },
          { "event": "core_get", "count": 4 },
          { "event": "victory", "count": 1 },
          { "ended": "victory" },
          { "hidden": "core_alpha" },
          { "hidden": "core_beta" },
          { "hidden": "core_gamma" },
          { "hidden": "core_delta" }
        ]
      },
      {
        "name": "rushing the exit without cores is locked",
        "spawn_group": "solo",
        "players": [{ "id": "p1", "character": "human", "spawn": "start" }],
        "script": [{ "player": "p1", "walk": "0,0; 12,0; 22.5,0" }, { "player": "p1", "wait": 0.5 }],
        "max_seconds": 25,
        "expect": [{ "event": "locked", "min": 1 }, { "no_event": "victory" }, { "not_ended": true }, { "var": "cores", "eq": 0 }]
      }
    ]
  },
