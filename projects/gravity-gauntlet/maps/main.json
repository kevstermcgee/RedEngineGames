    },
    { "id": "gust_a", "when": { "every": 1.0 }, "do": [{ "impulse": { "object": "bumper_alpha", "dir": [0.7, 0.1, 0.7], "speed": 6.0 } }] },
    { "id": "gust_b", "when": { "every": 1.3 }, "do": [{ "impulse": { "object": "bumper_beta", "dir": [-0.7, 0.1, -0.7], "speed": 6.0 } }] },
    { "id": "gate_locked", "when": { "enter": { "zone": "zone_goal" } }, "if": "cores < 4", "cooldown": 1.0, "do": [{ "emit": "locked" }] },
    { "id": "gate_victory", "when": { "enter": { "zone": "zone_goal" } }, "if": "cores >= 4", "do": [{ "emit": "victory" }, { "end": "victory" }] }
  ],
