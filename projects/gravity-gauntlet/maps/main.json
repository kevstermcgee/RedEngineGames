  "rules": [
    {
      "id": "core_1",
      "when": { "enter": { "object": "core_alpha", "pad": 0.6 } },
      "once": true,
      "do": [{ "add": ["cores", 1] }, { "hide": "core_alpha" }, { "emit": "core_get" }]
