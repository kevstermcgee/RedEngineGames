    },
    { "id": "goal_locked", "when": { "enter": { "zone": "goal" } }, "if": "banks < 3", "cooldown": 1, "do": [{ "emit": "locked" }] },
    { "id": "goal_open", "when": { "enter": { "zone": "goal" } }, "if": "banks >= 3", "do": [{ "emit": "victory" }, { "end": "victory" }] }
