{
  "blueprint": 1,
  "name": "Domino Dynamo",
  "height": 3.2,
  "rooms": [{ "id": "reactor", "rect": [-10, -9, 10, 9], "floor": "#242126" }],
  "spawns": [{ "room": "reactor", "group": "solo", "count": 1, "id": "start" }],
  "keep_clear": [[-1.5, -8, 1.5, 8]],
  "prefab_files": ["../assets/gameplay.json"],
  "extra": [
    { "id": "switch_a", "type": "box", "position": [-7, 0.03, 6], "size": [2, 0.06, 2], "collide": false, "material": { "color": "#402020", "emissive": "#ff4e4e" } },
    { "id": "switch_b", "type": "box", "position": [0, 0.03, 6], "size": [2, 0.06, 2], "collide": false, "material": { "color": "#403820", "emissive": "#ffd84e" } },
    { "id": "switch_c", "type": "box", "position": [7, 0.03, 6], "size": [2, 0.06, 2], "collide": false, "material": { "color": "#203040", "emissive": "#4ec8ff" } },
    { "id": "exit", "type": "box", "position": [0, 1.2, -8.5], "size": [3.5, 2.4, 0.2], "collide": false, "material": { "color": "#20402f", "emissive": "#45ff9a" } },
    { "id": "a0", "type": "box", "position": [-7, 0.8, 2], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#ff5353" } },
    { "id": "a1", "type": "box", "position": [-7, 0.8, 0.9], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#ed6767" } },
    { "id": "a2", "type": "box", "position": [-7, 0.8, -0.2], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#db7b7b" } },
    { "id": "b0", "type": "box", "position": [2.5, 0.8, 2], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#ffd84e" } },
    { "id": "b1", "type": "box", "position": [2.5, 0.8, 0.9], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#eacb68" } },
    { "id": "b2", "type": "box", "position": [2.5, 0.8, -0.2], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#d6bf82" } },
    { "id": "c0", "type": "box", "position": [7, 0.8, 2], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#4ec8ff" } },
    { "id": "c1", "type": "box", "position": [7, 0.8, 0.9], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#69c5ee" } },
    { "id": "c2", "type": "box", "position": [7, 0.8, -0.2], "size": [0.35, 1.6, 0.8], "movable": true, "material": { "color": "#84c2dc" } }
  ],
  "scene": {
    "vars": { "banks": 0 },
    "zones": [
      { "id": "pad_a", "rect": [-8, 5, -6, 7], "y": 0, "kind": "trigger" },
      { "id": "pad_b", "rect": [-1, 5, 1, 7], "y": 0, "kind": "trigger" },
      { "id": "pad_c", "rect": [6, 5, 8, 7], "y": 0, "kind": "trigger" },
      { "id": "goal", "rect": [-2, -9, 2, -7.5], "y": 0, "kind": "goal" }
    ],
    "rules": [
      { "id": "bank_a", "when": { "enter": { "zone": "pad_a" } }, "once": true,
        "do": [{ "impulse": { "object": "a0", "dir": [0, 0, -1], "speed": 5 } }, { "add": ["banks", 1] }, { "emit": "bank" }] },
      { "id": "bank_b", "when": { "enter": { "zone": "pad_b" } }, "once": true,
        "do": [{ "impulse": { "object": "b0", "dir": [0, 0, -1], "speed": 5 } }, { "add": ["banks", 1] }, { "emit": "bank" }] },
      { "id": "bank_c", "when": { "enter": { "zone": "pad_c" } }, "once": true,
        "do": [{ "impulse": { "object": "c0", "dir": [0, 0, -1], "speed": 5 } }, { "add": ["banks", 1] }, { "emit": "bank" }] },
      { "id": "goal_locked", "when": { "enter": { "zone": "goal" } }, "if": "banks < 3", "cooldown": 1, "do": [{ "emit": "locked" }] },
      { "id": "goal_open", "when": { "enter": { "zone": "goal" } }, "if": "banks >= 3", "do": [{ "emit": "victory" }, { "end": "victory" }] }
    ],
    "checks": {
      "sim": [{
        "name": "trigger all three domino banks then exit",
        "players": [{ "id": "p1", "character": "human", "spawn": "start" }],
        "script": [{ "player": "p1", "walk": "0,0; -7,6; 0,6; 7,6; 0,-8" }],
        "max_seconds": 30,
        "expect": [{ "var": "banks", "eq": 3 }, { "event": "bank", "count": 3 }, { "ended": "victory" }]
      }]
    }
  }
}
