   },
   "do": [
    {
     "add": [
      "time_left",
      -1
     ]
    }
   ]
  },
  {
   "id": "timeup",
   "when": {
    "every": 1
   },
   "if": "time_left <= 0",
   "do": [
    {
     "emit": "timeup"
    },
    {
     "end": "timeup"
    }
   ]
  },
  {
   "id": "ammo_out",
   "when": {
    "prop_exit": {
     "zone": "depot"
    }
   },
   "do": [
    {
     "add": [
      "ammo",
      -1
     ]
    }
   ]
  },
  {
   "id": "ammo_back",
   "when": {
    "prop_enter": {
     "zone": "depot"
    }
   },
   "do": [
    {
     "add": [
      "ammo",
      1
     ]
    }
   ]
  },
  {
   "id": "flag_down",
   "when": {
    "prop_below": [
     "flag",
     2.5599999999999996
    ]
   },
   "once": true,
   "do": [
    {
     "set": [
      "flag_down",
      1
     ]
    },
    {
     "emit": "flag"
    }
   ]
  },
  {
   "id": "count",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "set": [
      "knocked",
      "((moved(block_0_0) > 0.8) || (tilt(block_0_0) > 45)) + ((moved(block_0_1) > 0.8) || (tilt(block_0_1) > 45)) + ((moved(block_0_2) > 0.8) || (tilt(block_0_2) > 45)) + ((moved(block_0_3) > 0.8) || (tilt(block_0_3) > 45)) + ((moved(block_0_4) > 0.8) || (tilt(block_0_4) > 45)) + ((moved(block_1_0) > 0.8) || (tilt(block_1_0) > 45)) + ((moved(block_1_1) > 0.8) || (tilt(block_1_1) > 45)) + ((moved(block_1_2) > 0.8) || (tilt(block_1_2) > 45)) + ((moved(block_1_3) > 0.8) || (tilt(block_1_3) > 45)) + ((moved(block_2_0) > 0.8) || (tilt(block_2_0) > 45)) + ((moved(block_2_1) > 0.8) || (tilt(block_2_1) > 45)) + ((moved(block_2_2) > 0.8) || (tilt(block_2_2) > 45)) + ((moved(block_3_0) > 0.8) || (tilt(block_3_0) > 45)) + ((moved(block_3_1) > 0.8) || (tilt(block_3_1) > 45)) + ((moved(block_4_0) > 0.8) || (tilt(block_4_0) > 45))"
     ]
    },
    {
     "set": [
      "score",
      "knocked + 3 * flag_down"
     ]
    },
    {
     "emit": "counted"
    }
   ]
  },
  {
   "id": "win",
   "when": {
    "event": "counted"
   },
   "if": "score >= goal",
   "do": [
    {
     "emit": "victory"
    },
    {
     "end": "victory"
    }
   ]
  }
