{
  "meta": {
    "fps": 30,
    "duration": 10,
    "resolution": [1280, 720]
  },
  "background": {
    "sky_top": "#001020",
    "sky_bottom": "#000510"
  },
  "ambient": {
    "color": "#3399ff",
    "intensity": 0.5
  },
  "camera": {
    "fov": 70,
    "position": [0, 11, 12],
    "target": [0, 0, 0]
  },
  "player": {
    "mode": "peaceful"
  },
  "spawns": [
    {
      "id": "spawn_start",
      "position": [-5.5, 0, 1.5],
      "yaw_deg": 0
    }
  ],
  "zones": [
    {
      "id": "ped_1",
      "rect": [-4, -6, -2, -4],
      "y": 0
    },
    {
      "id": "ped_2",
      "rect": [-4, 0, -2, 2],
      "y": 0
    },
    {
      "id": "ped_3",
      "rect": [2, 0, 4, 2],
      "y": 0
    }
  ],
  "vars": {
    "ok1": 0,
    "ok2": 0,
    "ok3": 0,
    "lit": 0
  },
  "rules": [
    {
      "id": "start_dark",
      "when": {
        "start": true
      },
      "do": [
        {
          "hide": "beam_1"
        },
        {
          "hide": "beam_2"
        },
        {
          "hide": "beam_3"
        },
        {
          "hide": "target_lit"
        }
      ]
    },
    {
      "id": "prism_r_in",
      "when": {
        "prop_enter": {
          "zone": "ped_1"
        },
        "prop": "prism_r"
      },
      "do": [
        {
          "set": ["ok1", 1]
        },
        {
          "emit": "prism_1_seated"
        }
      ]
    },
    {
      "id": "prism_r_out",
      "when": {
        "prop_exit": {
          "zone": "ped_1"
        },
        "prop": "prism_r"
      },
      "do": [
        {
          "set": ["ok1", 0]
        }
      ]
    },
    {
      "id": "prism_g_wrong_1",
      "when": {
        "prop_enter": {
          "zone": "ped_1"
        },
        "prop": "prism_g"
      },
      "do": [
        {
          "emit": "wrong_prism"
        }
      ]
    },
    {
      "id": "prism_b_wrong_1",
      "when": {
        "prop_enter": {
          "zone": "ped_1"
        },
        "prop": "prism_b"
      },
      "do": [
        {
          "emit": "wrong_prism"
        }
      ]
    },
    {
      "id": "prism_r_wrong_2",
      "when": {
        "prop_enter": {
          "zone": "ped_2"
        },
        "prop": "prism_r"
      },
      "do": [
        {
          "emit": "wrong_prism"
        }
      ]
    },
    {
      "id": "prism_g_in",
      "when": {
        "prop_enter": {
          "zone": "ped_2"
        },
        "prop": "prism_g"
      },
      "do": [
        {
          "set": ["ok2", 1]
        },
        {
          "emit": "prism_2_seated"
        }
      ]
    },
    {
      "id": "prism_g_out",
      "when": {
        "prop_exit": {
          "zone": "ped_2"
        },
        "prop": "prism_g"
      },
      "do": [
        {
          "set": ["ok2", 0]
        }
      ]
    },
    {
      "id": "prism_b_wrong_2",
      "when": {
        "prop_enter": {
          "zone": "ped_2"
        },
        "prop": "prism_b"
      },
      "do": [
        {
          "emit": "wrong_prism"
        }
      ]
    },
    {
      "id": "prism_r_wrong_3",
      "when": {
        "prop_enter": {
          "zone": "ped_3"
        },
        "prop": "prism_r"
      },
      "do": [
        {
          "emit": "wrong_prism"
        }
      ]
    },
    {
      "id": "prism_g_wrong_3",
      "when": {
        "prop_enter": {
          "zone": "ped_3"
        },
        "prop": "prism_g"
      },
      "do": [
        {
          "emit": "wrong_prism"
        }
      ]
    },
    {
      "id": "prism_b_in",
      "when": {
        "prop_enter": {
          "zone": "ped_3"
        },
        "prop": "prism_b"
      },
      "do": [
        {
          "set": ["ok3", 1]
        },
        {
          "emit": "prism_3_seated"
        }
      ]
    },
    {
      "id": "prism_b_out",
      "when": {
        "prop_exit": {
          "zone": "ped_3"
        },
        "prop": "prism_b"
      },
      "do": [
        {
          "set": ["ok3", 0]
        }
      ]
    },
    {
      "id": "beam_1_on",
      "when": {
        "every": 0.25
      },
      "if": "ok1 == 1",
      "do": [
        {
          "show": "beam_1"
        }
      ]
    },
    {
      "id": "beam_1_off",
      "when": {
        "every": 0.25
      },
      "if": "!(ok1 == 1)",
      "do": [
        {
          "hide": "beam_1"
        }
      ]
    },
    {
      "id": "beam_2_on",
      "when": {
        "every": 0.25
      },
      "if": "ok1 == 1 && ok2 == 1",
      "do": [
        {
          "show": "beam_2"
        }
      ]
    },
    {
      "id": "beam_2_off",
      "when": {
        "every": 0.25
      },
      "if": "!(ok1 == 1 && ok2 == 1)",
      "do": [
        {
          "hide": "beam_2"
        }
      ]
    },
    {
      "id": "beam_3_on",
      "when": {
        "every": 0.25
      },
      "if": "ok1 == 1 && ok2 == 1 && ok3 == 1",
      "do": [
        {
          "show": "beam_3"
        }
      ]
    },
    {
      "id": "beam_3_off",
      "when": {
        "every": 0.25
      },
      "if": "!(ok1 == 1 && ok2 == 1 && ok3 == 1)",
      "do": [
        {
          "hide": "beam_3"
        }
      ]
    },
    {
      "id": "target_on",
      "when": {
        "every": 0.25
      },
      "if": "ok1 == 1 && ok2 == 1 && ok3 == 1",
      "do": [
        {
          "show": "target_lit"
        },
        {
          "add": ["lit", 1]
        }
      ]
    },
    {
      "id": "target_off",
      "when": {
        "every": 0.25
      },
      "if": "!(ok1 == 1 && ok2 == 1 && ok3 == 1)",
      "do": [
        {
          "hide": "target_lit"
        },
        {
          "set": ["lit", 0]
        }
      ]
    },
    {
      "id": "win",
      "when": {
        "every": 0.25
      },
      "if": "lit >= 8",
      "once": true,
      "do": [
        {
          "emit": "mainframe_energized"
        },
        {
          "end": "victory"
        }
      ]
    },
    {
      "id": "timeout",
      "when": {
        "after": 180
      },
      "do": [
        {
          "end": "timeout"
        }
      ]
    }
  ],
