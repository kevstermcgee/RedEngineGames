{
  "meta": {
    "fps": 30,
    "duration": 10,
    "resolution": [1280, 720]
  },
  "background": {
    "sky_top": "#101826",
    "sky_bottom": "#05080f"
  },
  "ambient": {
    "color": "#aabbdd",
    "intensity": 0.6
  },
  "camera": {
    "fov": 70,
    "position": [0, 9, 10],
    "target": [0, 0, 0]
  },
  "player": {
    "mode": "peaceful"
  },
  "spawns": [
    {
      "id": "spawn_start",
      "position": [0, 0, 6],
      "yaw_deg": 180
    }
  ],
  "zones": [
    {
      "id": "pan_left",
      "rect": [-6, -4, -3, -1],
      "y": 0
    },
    {
      "id": "pan_right",
      "rect": [3, -4, 6, -1],
      "y": 0
    }
  ],
  "vars": {
    "left_w": 0,
    "right_w": 0,
    "hold": 0
  },
  "rules": [
    {
      "id": "weigh_left",
      "when": {
        "every": 0.25
      },
      "do": [
        {
          "set": ["left_w", "in_zone(crate_a, pan_left) * mass(crate_a) + in_zone(crate_b, pan_left) * mass(crate_b) + in_zone(crate_c, pan_left) * mass(crate_c) + in_zone(crate_d, pan_left) * mass(crate_d)"]
        }
      ]
    },
    {
      "id": "weigh_right",
      "when": {
        "every": 0.25
      },
      "do": [
        {
          "set": ["right_w", "in_zone(crate_a, pan_right) * mass(crate_a) + in_zone(crate_b, pan_right) * mass(crate_b) + in_zone(crate_c, pan_right) * mass(crate_c) + in_zone(crate_d, pan_right) * mass(crate_d)"]
        }
      ]
    },
    {
      "id": "left_loaded",
      "when": {
        "prop_enter": {
          "zone": "pan_left"
        }
      },
      "do": [
        {
          "emit": "left_loaded"
        }
      ]
    },
    {
      "id": "right_loaded",
      "when": {
        "prop_enter": {
          "zone": "pan_right"
        }
      },
      "do": [
        {
          "emit": "right_loaded"
        }
      ]
    },
    {
      "id": "hold_on",
      "when": {
        "every": 0.5
      },
      "if": "left_w > 0 && right_w > 0 && left_w - right_w < 0.05 * (left_w + right_w) && right_w - left_w < 0.05 * (left_w + right_w)",
      "do": [
        {
          "add": ["hold", 1]
        }
      ]
    },
    {
      "id": "hold_off",
      "when": {
        "every": 0.5
      },
      "if": "!(left_w > 0 && right_w > 0 && left_w - right_w < 0.05 * (left_w + right_w) && right_w - left_w < 0.05 * (left_w + right_w))",
      "do": [
        {
          "set": ["hold", 0]
        }
      ]
    },
    {
      "id": "win",
      "when": {
        "every": 0.5
      },
      "if": "hold >= 4",
      "once": true,
      "do": [
        {
          "emit": "equilibrium_achieved"
        },
        {
          "end": "victory"
        }
      ]
    },
    {
      "id": "timeout",
      "when": {
        "after": 150
      },
      "do": [
        {
          "emit": "scale_jammed"
        },
        {
          "end": "timeout"
        }
      ]
    }
  ],
  "objects": [
    {
      "id": "floor",
      "type": "plane",
      "size": [16, 16],
